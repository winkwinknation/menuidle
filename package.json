{
  "name": "menu-idle",
  "version": "0.1.0",
  "description": "Menu Idle — a fullscreen incremental game about exploring infinite, procedurally generated menus.",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k -n vite,electron -c green,blue \"vite\" \"wait-on tcp:127.0.0.1:5173 && node scripts/dev-electron.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/dev-electron.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "break_infinity.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wait-on": "^8.0.1"
  }
}
